[Unit]
Description=Mentorian Evolution API stable auto-update
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/mentorian-evolution-updater.env
ExecStart=/usr/local/sbin/mentorian-evolution-auto-update
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
