# ── wa-hub / .env ──────────────────────────────────────────────────────────────
# Copie para `.env` e troque os valores. Use `openssl rand -hex 32` para segredos.

# Segredo do broker (header x-hub-secret). OBRIGATÓRIO.
HUB_SECRET=TROQUE_openssl_rand_hex_32

# Mentorian: falha fechada. O inventario funciona em false; QR, envio, import,
# exclusao e migracao so ficam disponiveis depois de habilitacao operacional.
HUB_MUTATIONS_ENABLED=false
# A interface usada em producao e a pagina privada do MentorOps. A UI upstream
# guarda HUB_SECRET no localStorage, portanto permanece desligada no broker.
HUB_STATIC_UI_ENABLED=false

# Postgres compartilhado (DBs isolados: evolution_db, evogo_auth, evogo_users, wuzapi, waha)
PG_PASSWORD=TROQUE_SENHA_PG

# Evolution API (Baileys)
EVO_GLOBAL_KEY=TROQUE_EVO_GLOBAL_KEY

# Evolution Go (whatsmeow) — LICENÇA obrigatória (ativar via /license/activate?code=...)
EVOGO_GLOBAL_KEY=TROQUE_EVOGO_GLOBAL_KEY

# WuzAPI (whatsmeow) — UPSTREAM asternic/wuzapi. Construa a imagem UMA vez do Dockerfile do repo:
#   docker build -t wuzapi:hub https://github.com/asternic/wuzapi.git
#   O upstream NÃO tem esse endpoint → o broker importa via SQL direto.
WUZAPI_ADMIN_TOKEN=TROQUE_WUZAPI_ADMIN
WUZAPI_GLOBAL_ENCRYPTION_KEY=TROQUE_WUZAPI_ENCRYPTION_KEY
WUZAPI_GLOBAL_HMAC_KEY=TROQUE_WUZAPI_HMAC_KEY
WUZAPI_IMAGE=wuzapi:hub
# Modo de import: auto (nativo->SQL) | native (só fork) | sql (só upstream/SQL)
WUZAPI_IMPORT_MODE=auto

# WAHA (>= 2026.6.1 = tudo grátis)
WAHA_API_KEY=TROQUE_WAHA_KEY

# UAZAPI — API HOSPEDADA externa (não é serviço na stack). Token admin do cliente.
UAZAPI_API_URL=https://api.uazapi.com
UAZAPI_ADMIN_TOKEN=

# Tags das imagens (FIXAR — nunca :latest em produção). WuzAPI é buildado (ver acima).
EVO_IMAGE=evoapicloud/evolution-api:v2.3.7
EVOGO_IMAGE=evoapicloud/evolution-go:0.7.2
# WAHA: tag no formato <variante>-<versao>. noweb = engine NOWEB (enxuto, sem Chromium).
#   p/ todos os engines (inclui WEBJS/GOWS): latest-2026.7.1  |  só GOWS: gows-2026.7.1
WAHA_IMAGE=devlikeapro/waha:noweb-2026.7.1
